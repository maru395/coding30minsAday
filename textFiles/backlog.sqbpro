<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="backlog.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1218"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="domains" custom_title="0" dock_id="1" table="4,7:maindomains"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000011300ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE providers (
    provider_id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE
);

-- 2. Create the Domains table with a Foreign Key
CREATE TABLE domains (
    domain_id INTEGER PRIMARY KEY AUTOINCREMENT,
    domain_name TEXT NOT NULL UNIQUE,
    provider_id INTEGER,
    FOREIGN KEY (provider_id) REFERENCES providers(provider_id)
);

-- 3. Insert the Providers
INSERT INTO providers (name) VALUES ('Gmail'), ('Yahoo'), ('Outlook');

-- 4. Insert the Domains tied to their respective Provider IDs
-- (1 = Gmail, 2 = Yahoo, 3 = Outlook)
INSERT INTO domains (domain_name, provider_id) VALUES 
('gmail.com', 1), ('googlemail.com', 1),
('yahoo.com', 2), ('ymail.com', 2), ('rocketmail.com', 2), ('yahoo.co.uk', 2), ('yahoo.ca', 2),
('outlook.com', 3), ('hotmail.com', 3), ('live.com', 3), ('msn.com', 3);</sql><current_tab id="0"/></tab_sql></sqlb_project>
